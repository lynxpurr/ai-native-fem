{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lynxpurr/ai-native-fem/develop/schemas/model-v1.5.json",
  "title": "ANF model declaration 1.5",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.5"
    },
    "problem_type": {
      "const": "planar_structure"
    },
    "units": {
      "type": "object",
      "properties": {
        "length": {
          "const": "m"
        },
        "force": {
          "const": "N"
        },
        "stress": {
          "const": "Pa"
        }
      },
      "additionalProperties": false,
      "required": [
        "length",
        "force",
        "stress"
      ]
    },
    "analysis": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "harmonic"
            },
            "frequencies_hz": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "damping": {
              "$ref": "#/$defs/damping"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "frequencies_hz"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "transient"
            },
            "time": {
              "$ref": "#/$defs/time"
            },
            "damping": {
              "$ref": "#/$defs/damping"
            },
            "initial_state": {
              "$ref": "#/$defs/initial_state"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "time"
          ]
        }
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "minProperties": 2,
          "maxProperties": 200
        },
        "members": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}(?![\\s\\S])"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "truss2d"
                  },
                  "i": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}(?![\\s\\S])"
                  },
                  "j": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}(?![\\s\\S])"
                  },
                  "young_modulus": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "area": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "elements": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1,
                    "maximum": 1
                  },
                  "density": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind",
                  "i",
                  "j",
                  "young_modulus",
                  "area",
                  "density"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "frame2d"
                  },
                  "i": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}(?![\\s\\S])"
                  },
                  "j": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}(?![\\s\\S])"
                  },
                  "young_modulus": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "area": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "second_moment": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "elements": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1,
                    "maximum": 32
                  },
                  "density": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind",
                  "i",
                  "j",
                  "young_modulus",
                  "area",
                  "second_moment",
                  "density"
                ]
              }
            ]
          },
          "minProperties": 1,
          "maxProperties": 400
        },
        "supports": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "ux": {
                "type": "number"
              },
              "uy": {
                "type": "number"
              },
              "rz": {
                "type": "number"
              }
            },
            "additionalProperties": false,
            "required": [],
            "minProperties": 1
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "nodes",
        "members",
        "supports"
      ]
    },
    "loads": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "problem_type",
    "units",
    "analysis",
    "model",
    "loads"
  ],
  "description": "Versioned SI inputs for consistent-mass planar harmonic and transient analysis. Runtime validation also checks UTF-8 JSON byte limits, duplicate keys, finite floating-point representation, mass density, mesh, frequency, step and DOF-time budgets, and zero supports.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}(?![\\s\\S])"
    },
    "vector": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "case": {
      "type": "object",
      "properties": {
        "nodal": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "fx": {
                "type": "number"
              },
              "fy": {
                "type": "number"
              },
              "mz": {
                "type": "number"
              }
            },
            "additionalProperties": false,
            "required": []
          }
        },
        "member_line": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "basis": {
                "enum": [
                  "local",
                  "global"
                ]
              },
              "i": {
                "$ref": "#/$defs/vector"
              },
              "j": {
                "$ref": "#/$defs/vector"
              }
            },
            "additionalProperties": false,
            "required": [
              "basis",
              "i",
              "j"
            ]
          }
        },
        "self_weight": {
          "type": "object",
          "properties": {
            "acceleration": {
              "$ref": "#/$defs/vector"
            },
            "density": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "acceleration",
            "density"
          ]
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "connection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "release"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rotational_spring"
            },
            "stiffness": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "stiffness"
          ]
        }
      ]
    },
    "damping": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "rayleigh"
        },
        "alpha": {
          "type": "number",
          "minimum": 0
        },
        "beta": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "time": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "start_s": {
              "type": "number",
              "minimum": 0
            },
            "end_s": {
              "type": "number"
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            }
          },
          "additionalProperties": false,
          "required": [
            "start_s",
            "end_s",
            "steps"
          ]
        },
        {
          "type": "object",
          "properties": {
            "times_s": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5001,
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "times_s"
          ]
        }
      ]
    },
    "state": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "ux": {
            "type": "number"
          },
          "uy": {
            "type": "number"
          },
          "rz": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": []
      }
    },
    "initial_state": {
      "type": "object",
      "properties": {
        "displacement": {
          "$ref": "#/$defs/state"
        },
        "velocity": {
          "$ref": "#/$defs/state"
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "harmonic_loads": {
      "type": "object",
      "properties": {
        "nodal": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "fx": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "amplitude": {
                        "type": "number"
                      },
                      "phase_deg": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "amplitude"
                    ]
                  }
                ]
              },
              "fy": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "amplitude": {
                        "type": "number"
                      },
                      "phase_deg": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "amplitude"
                    ]
                  }
                ]
              },
              "mz": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "amplitude": {
                        "type": "number"
                      },
                      "phase_deg": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "amplitude"
                    ]
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": []
          }
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "transient_loads": {
      "type": "object",
      "properties": {
        "nodal": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "fx": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "constant"
                      },
                      "amplitude": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "amplitude"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "ramp"
                      },
                      "amplitude": {
                        "type": "number"
                      },
                      "t0_s": {
                        "type": "number"
                      },
                      "t1_s": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "amplitude",
                      "t0_s",
                      "t1_s"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "harmonic"
                      },
                      "amplitude": {
                        "type": "number"
                      },
                      "frequency_hz": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "phase_deg": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "amplitude",
                      "frequency_hz"
                    ]
                  }
                ]
              },
              "fy": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "constant"
                      },
                      "amplitude": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "amplitude"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "ramp"
                      },
                      "amplitude": {
                        "type": "number"
                      },
                      "t0_s": {
                        "type": "number"
                      },
                      "t1_s": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "amplitude",
                      "t0_s",
                      "t1_s"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "harmonic"
                      },
                      "amplitude": {
                        "type": "number"
                      },
                      "frequency_hz": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "phase_deg": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "amplitude",
                      "frequency_hz"
                    ]
                  }
                ]
              },
              "mz": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "constant"
                      },
                      "amplitude": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "amplitude"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "ramp"
                      },
                      "amplitude": {
                        "type": "number"
                      },
                      "t0_s": {
                        "type": "number"
                      },
                      "t1_s": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "amplitude",
                      "t0_s",
                      "t1_s"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "harmonic"
                      },
                      "amplitude": {
                        "type": "number"
                      },
                      "frequency_hz": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "phase_deg": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "amplitude",
                      "frequency_hz"
                    ]
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": []
          }
        }
      },
      "additionalProperties": false,
      "required": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "analysis": {
            "properties": {
              "type": {
                "const": "harmonic"
              }
            }
          }
        },
        "required": [
          "analysis"
        ]
      },
      "then": {
        "properties": {
          "loads": {
            "$ref": "#/$defs/harmonic_loads"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis": {
            "properties": {
              "type": {
                "const": "transient"
              }
            }
          }
        },
        "required": [
          "analysis"
        ]
      },
      "then": {
        "properties": {
          "loads": {
            "$ref": "#/$defs/transient_loads"
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lynxpurr/ai-native-fem/develop/schemas/transient-results-v1.5.json",
  "title": "ANF transient result manifest 1.5",
  "description": "Manifest for a schema 1.5 transient result directory. The numeric arrays are stored in arrays.npz; runtime validation also checks finite values, shapes, the input hash, the summary peaks and the array digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "model",
    "input_hash",
    "point_count",
    "steps",
    "start_s",
    "dt_s",
    "global_peaks",
    "worst_backward_error",
    "worst_backward_step",
    "diagnostics",
    "versions",
    "dof_labels",
    "arrays",
    "arrays_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.5"
    },
    "kind": {
      "const": "transient_result"
    },
    "model": {
      "type": "object",
      "description": "The normalized schema 1.5 model declaration."
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "point_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 5001
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "start_s": {
      "type": "number",
      "minimum": 0
    },
    "dt_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "global_peaks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displacement",
        "velocity",
        "acceleration"
      ],
      "properties": {
        "displacement": {
          "$ref": "#/$defs/peak"
        },
        "velocity": {
          "$ref": "#/$defs/peak"
        },
        "acceleration": {
          "$ref": "#/$defs/peak"
        }
      }
    },
    "worst_backward_error": {
      "type": "number",
      "minimum": 0
    },
    "worst_backward_step": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1
    },
    "dof_labels": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        }
      }
    },
    "arrays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "times_s",
        "displacement",
        "velocity",
        "acceleration",
        "energy",
        "peak_displacement",
        "peak_time_s"
      ],
      "properties": {
        "times_s": {
          "$ref": "#/$defs/array"
        },
        "displacement": {
          "$ref": "#/$defs/array"
        },
        "velocity": {
          "$ref": "#/$defs/array"
        },
        "acceleration": {
          "$ref": "#/$defs/array"
        },
        "energy": {
          "$ref": "#/$defs/array"
        },
        "peak_displacement": {
          "$ref": "#/$defs/array"
        },
        "peak_time_s": {
          "$ref": "#/$defs/array"
        }
      }
    },
    "arrays_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "array": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "dtype"
      ],
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dtype": {
          "const": "float64"
        }
      }
    },
    "peak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "time_s",
        "dof"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "time_s": {
          "type": "number"
        },
        "dof": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}